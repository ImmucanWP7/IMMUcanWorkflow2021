library(tools)
sce <- read_steinbock(paste0(mount_path,"IMC/"),
return_as = "sce",
extract_imagemetadata_from = c("width_px",	"height_px",
"acquisition_id"))
sce$image <- paste0(sce$sample_id, ".tiff")
sce$patient_id <- sub("_", "", str_extract(sce$image, "_[0-9]{8}"))
assay(sce, "exprs") <- asinh(counts(sce))
# Specify interesting channels
rowData(sce)$use_channel <- !grepl("DNA|HistoneH3", rownames(sce))
meta <- read.csv(paste0(mount_path,"IMC/sample_metadata.csv"))
meta$patient_id <- as.character(meta$patient_id)
cell_meta <- left_join(as.data.frame(colData(sce)), meta,
by = "patient_id")
all.equal(paste(cell_meta$image, cell_meta$ObjectNumber),
paste(sce$image, sce$ObjectNumber))
colData(sce) <- as(cell_meta, "DataFrame")
sce$ROI <- sub("_", "", str_extract(sce$image, "_00[1-9]"))
library(dittoSeq)
library(RColorBrewer)
color_vectors <- list()
matched_celltype <- setNames(c("sienna4", "magenta3", "skyblue3", "green3", "grey75", "green4", "#BF0A3D", "#F4800C"),
c("Tumor", "T", "Neutrophil", "MacCD163",
"other", "DC", "B", "BnT"))
patient_id <- setNames(c("#BE1E2D", "#FF4B5B", "#F7941D", "#FFCA89", "#00A651", "#5FFF73", "#00AEEF", "#9BD7FF", "#2E3192", "#675BFF"),
c("10061074", "10067433", "10068868", "10071582", "10073140", "10074349", "10074832", "10075371", "10075572", "10082495"))
col_vec_ROIs <- colorRampPalette(c("dark green", "white", "dark red"))(length(unique(sce$ROI)))
names(col_vec_ROIs) <- unique(sce$ROI)
col_vec_indication <- c(CRC = "#5B1C55", SCCHN = "#39BEB4", NSCLC = "#F79C1D",
BCC = "#3F85A7", RCC = "#C81F43")
celltype <- setNames(c("#BF0A3D", "goldenrod1", "palevioletred1",
"darkorchid", "maroon3", "#F4800C",
"green4", "darkgreen",
"green3", "skyblue3", "yellow2",
"deepskyblue", "tomato", "sienna4",
"grey75"),
c("B", "plasma", "CD4", "CD8", "Treg", "BnT",
"DC", "HLADR", "MacCD163", "Neutrophil",
"NK", "pDC", "Mural", "Tumor", "undefined"))
color_vectors$celltype <- celltype
color_vectors$patient_id <- patient_id
color_vectors$ROIs <- col_vec_ROIs
color_vectors$Indication <- col_vec_indication
color_vectors$matched_celltype <- matched_celltype
# Save in metadata slot
metadata(sce)$color_vectors <- color_vectors
library(imcRtools)
sce <- buildSpatialGraph(sce, img_id = "sample_id", type = "expansion",
threshold = 20, name = "expansion_20")
sce <- buildSpatialGraph(sce, img_id = "sample_id", type = "expansion",
threshold = 30, name = "expansion_30")
cur_dir <- paste0(mount_path,"IMC/Rout/")
if (!dir.exists(cur_dir)) dir.create(cur_dir)
saveRDS(sce, paste0(mount_path,"IMC/Rout/sce.rds"))
library(cytomapper)
images <- loadImages(paste0(mount_path,"IMC/img/"))
masks <- loadImages(paste0(mount_path,"IMC/masks/"),
as.is = TRUE)
channelNames(images) <- rownames(sce)
mcols(images) <- mcols(masks) <- DataFrame(image = names(images),
sample_id = sub(".tiff", "", names(images)))
saveRDS(images, paste0(mount_path,"IMC/Rout/images.rds"))
saveRDS(masks, paste0(mount_path,"IMC/Rout/masks.rds"))
knitr::opts_chunk$set(echo = TRUE, eval = TRUE)
knitr::opts_knit$set(root.dir = rprojroot::find_rstudio_root_file())
mount_path <- readRDS(file = "data/mount_path.rds")
library(imcRtools)
library(CATALYST)
library(cytomapper)
sce <- readRDS(paste0(mount_path,"IMC/Rout/sce.rds"))
images <- readRDS(paste0(mount_path,"IMC/Rout/images.rds"))
# Add column names
colnames(sce) <- paste(sce$patient_id, sce$ROI, sce$ObjectNumber, sep = "_")
sce_spill <- readSCEfromTXT(paste0(mount_path,"IMC/compensation/20220201_IMMUcan_panel_1_1.10_compensation/"))
assay(sce_spill, "exprs") <- asinh(counts(sce_spill)/5)
plotSpotHeatmap(sce_spill)
plotSpotHeatmap(sce_spill, log = FALSE, threshold = 70)
bc_key <- as.numeric(unique(sce_spill$sample_mass))
bc_key <- bc_key[order(bc_key)]
sce_spill <- assignPrelim(sce_spill, bc_key = bc_key)
sce_spill <- estCutoffs(sce_spill)
sce_spill <- applyCutoffs(sce_spill)
library(pheatmap)
cur_table <- table(sce_spill$bc_id, sce_spill$sample_mass)
pheatmap(log10(cur_table + 1),
cluster_rows = FALSE,
cluster_cols = FALSE)
sce_spill <- filterPixels(sce_spill, minevents = 40, correct_pixels = TRUE)
sce_spill <- computeSpillmat(sce_spill)
isotope_list <- CATALYST::isotope_list
isotope_list$Ar <- 80
plotSpillmat(sce_spill, isotope_list = isotope_list)
rowData(sce)$channel_name <- paste0(rowData(sce)$channel, "Di")
sm <- metadata(sce_spill)$spillover_matrix
sce <- compCytof(sce, sm,
transform = TRUE, cofactor = 1,
isotope_list = isotope_list,
overwrite = FALSE)
library(dittoSeq)
library(patchwork)
before <- dittoScatterPlot(sce, x.var = "CD15", y.var = "CD45RA",
assay.x = "exprs", assay.y = "exprs") +
ggtitle("Before compensation")
after <- dittoScatterPlot(sce, x.var = "CD15", y.var = "CD45RA",
assay.x = "compexprs", assay.y = "compexprs") +
ggtitle("After compensation")
before + after
before <- dittoScatterPlot(sce, x.var = "Ecad", y.var = "CD303",
assay.x = "exprs", assay.y = "exprs") +
ggtitle("Before compensation")
after <- dittoScatterPlot(sce, x.var = "Ecad", y.var = "CD303",
assay.x = "compexprs", assay.y = "compexprs") +
ggtitle("After compensation")
before + after
assay(sce, "counts") <- assay(sce, "compcounts")
assay(sce, "exprs") <- assay(sce, "compexprs")
assay(sce, "compcounts") <- assay(sce, "compexprs") <- NULL
saveRDS(sce, paste0(mount_path,"IMC/Rout/sce.rds"))
channelNames(images) <- rowData(sce)$channel_name
library(BiocParallel)
adapted_sm <- adaptSpillmat(sm, rowData(sce)$channel_name,
isotope_list = isotope_list)
images_comp <- compImage(images, adapted_sm,
BPPARAM = MulticoreParam(workers = 4))
channelNames(images_comp) <- rownames(sce)
saveRDS(images_comp, paste0(mount_path,"IMC/Rout/images.rds"))
knitr::opts_chunk$set(echo = TRUE, eval = TRUE)
knitr::opts_knit$set(root.dir = rprojroot::find_rstudio_root_file())
mount_path <- readRDS(file = "data/mount_path.rds")
library(batchelor)
library(dittoSeq)
library(scater)
library(viridis)
library(DT)
library(BiocSingular)
library(cowplot)
sce <- readRDS(paste0(mount_path,"IMC/Rout/sce.rds"))
set.seed(220321)
out <- fastMNN(sce, batch = sce$patient_id,
auto.merge = TRUE,
subset.row = rowData(sce)$use_channel,
assay.type = "exprs",
d = 30,
BSPARAM = ExactParam())
# Transfer the correction results to the main spe object
reducedDim(sce, "fastMNN") <- reducedDim(out, "corrected")
merge_info <- metadata(out)$merge.info
datatable(data.frame(DataFrame(left = merge_info$left,
right = merge_info$right,
batch.size = merge_info$batch.size,
max_lost_var = rowMax(merge_info$lost.var))))
set.seed(220321)
sce <- runUMAP(sce, dimred = "fastMNN", name = "UMAP_fastMNN")
dittoDimPlot(sce, var = "patient_id", reduction.use = "UMAP_fastMNN", size = 0.2) +
scale_color_manual(values = metadata(sce)$color_vectors$patient_id) +
ggtitle("Patient ID on UMAP")
dittoDimPlot(sce, var = "indication", reduction.use = "UMAP_fastMNN", size = 0.2) +
scale_color_manual(values = metadata(sce)$color_vectors$Indication) +
ggtitle("Patient ID on UMAP")
p.list <- list()
for(i in rownames(sce)){
p.list[[i]] <- plotReducedDim(sce, colour_by = i, by_exprs_values = "exprs",
point_size = 0.1, point_alpha = 1, dimred = "UMAP_fastMNN")
}
plot_grid(plotlist = p.list, ncol = 7)
saveRDS(sce, paste0(mount_path,"IMC/Rout/sce.rds"))
